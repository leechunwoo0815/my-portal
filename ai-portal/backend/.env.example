# ============================================================
# AI技术门户 - 环境变量配置文件
# ============================================================
# 这是唯一需要修改的配置文件！
# 复制此文件为 .env，然后填入你的实际配置
# ============================================================

# === 应用基础配置 ===
# JWT签名密钥 - 必须修改！使用随机生成的长字符串（建议64位以上）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-strong-random-key

# 调试模式 - 生产环境必须设为 false
DEBUG=false

# CORS允许的来源（开发环境用，生产环境可删除）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === 数据库配置 ===
# SQLite数据库文件路径（相对路径，基于启动目录）
DATABASE_URL=sqlite:///./data/ai_portal.db

# === 大模型API密钥配置 ===
# 请至少配置一个模型的API密钥，否则聊天功能无法使用
# 密钥获取方式：
# - DeepSeek: https://platform.deepseek.com/
# - 智谱GLM: https://open.bigmodel.cn/
# - 通义千问: https://dashscope.aliyun.com/
# - 豆包: https://console.volcengine.com/ark/

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱GLM
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通义千问
QWEN_API_KEY=your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 豆包（火山引擎）
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# === 聊天限制 ===
# 每日调用次数限制（管理员不受限制）
DAILY_CHAT_LIMIT=50

# 单次请求最大Token数
MAX_TOKENS_PER_REQUEST=4096

# 默认聊天模型
DEFAULT_MODEL=deepseek-chat

# === RAG配置 ===
# ChromaDB持久化目录
CHROMA_PERSIST_DIR=./data/chroma

# 文档分块大小（字符数）
CHUNK_SIZE=500

# 分块重叠大小（字符数）
CHUNK_OVERLAP=50

# === 文件上传 ===
# 上传文件存储目录
UPLOAD_DIR=./data/uploads

# 最大上传文件大小（字节），默认50MB
MAX_UPLOAD_SIZE=52428800

# === 备份配置 ===
# 备份文件存储目录
BACKUP_DIR=./data/backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# === 管理员默认账号 ===
# 首次启动时自动创建的管理员账号
# TODO: 生产环境必须修改密码！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here
ADMIN_EMAIL=your-email@example.com
